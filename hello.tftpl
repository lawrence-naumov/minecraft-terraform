#!/bin/bash
set -e

sudo apt-get update
sudo apt-get install -y openjdk-21-jdk

mkdir -p /root/mc
cd /root/mc
wget https://maven.neoforged.net/releases/net/neoforged/neoforge/21.1.255/neoforge-21.1.255-installer.jar
java -jar neoforge-21.1.255-installer.jar
./run.sh

